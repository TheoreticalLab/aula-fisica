# Plantilla. Cópiela como privado/credenciales.env (privado/ está excluido de git) y complétela.
# Estas credenciales dan control total del proyecto: no las pegue en chats, correos ni en el código.

# Identificador del proyecto (la parte de https://XXXX.supabase.co)
SUPABASE_PROJECT_REF=rzymcllygsqiplkygymx

# Token personal de la CLI: https://supabase.com/dashboard/account/tokens (empieza por sbp_)
SUPABASE_ACCESS_TOKEN=

# Cadena de conexión a la base de datos (Supabase → botón «Connect» → «Session pooler» → URI),
# sustituyendo [YOUR-PASSWORD] por la contraseña de la base de datos del proyecto.
SUPABASE_DB_URL=

# Base de datos LOCAL para pruebas (PostgreSQL instalado en este equipo). No cambie salvo que sepa por qué.
LOCAL_DB_URL=postgresql:///aula_prueba?host=/var/run/postgresql
LOCAL_ADMIN_DB_URL=postgresql:///postgres?host=/var/run/postgresql
